{
  "name": "shererp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test:boundaries": "pnpm --filter @sher/boundaries run check",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @sher/api run dev"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "eslint": "9.18.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@primeuix/styles": "1.0.3"
    }
  }
}
